msgid "Logs are cleared due to clear at stop is enabled."
msgstr "由于已启用停止时清理，日志已清空。"

msgid "Proxy all UDP ports. High conntrack load. Use only when you need every UDP packet proxied."
msgstr "代理所有 UDP 端口。连接跟踪负载较高，仅在需要代理全部 UDP 流量时使用。"

msgid "Bypass proxy for these IPv4 addresses."
msgstr "对这些 IPv4 地址绕过代理。"

msgid "Bypass proxy for these IPv6 addresses."
msgstr "对这些 IPv6 地址绕过代理。"

msgid "Bypass proxy for these MAC addresses."
msgstr "对这些 MAC 地址绕过代理。"

msgid "Bypass proxy for these system users."
msgstr "对这些系统用户绕过代理。"

msgid "Match by IPv4 address. nftables: ip saddr."
msgstr "按 IPv4 地址匹配。nftables：ip saddr。"

msgid "Match by IPv6 address. nftables: ip6 saddr."
msgstr "按 IPv6 地址匹配。nftables：ip6 saddr。"

msgid "Match by MAC address. nftables: ether saddr."
msgstr "按 MAC 地址匹配。nftables：ether saddr。"

msgid "Match by cgroup path. Useful for Docker containers or systemd services. Requires cgroup v2."
msgstr "按 cgroup 路径匹配。适用于 Docker 容器或 systemd 服务。需要 cgroup v2。"

msgid "Match by system group ID (GID)."
msgstr "按系统用户组 ID（GID）匹配。"

msgid "Match by system user ID (UID). Example: force a specific service account to use proxy."
msgstr "按系统用户 ID（UID）匹配。例如：强制某个服务账户走代理。"

msgid "Matched users are forced to use proxy and DNS. Priority: after blacklist, before default policy. nftables: router_access_control chain."
msgstr "匹配的用户将被强制使用代理和 DNS。优先级：黑名单之后、默认策略之前。nftables：router_access_control 链。"

msgid "Highest priority. Devices listed here bypass proxy. Example: NAS (SMB performance), printer, IoT devices, game console with NAT issues."
msgstr "最高优先级。此处列出的设备绕过代理。例如：NAS（SMB 性能问题）、打印机、IoT 设备、NAT 异常的游戏机。"

msgid "Highest priority. Matched users bypass proxy immediately. Add root or ubus here to prevent locking yourself out. nftables: router_bypass_control chain."
msgstr "最高优先级。匹配的用户立即绕过代理。建议在此添加 root 或 ubus，防止把自己锁在外面。nftables：router_bypass_control 链。"

msgid "Force specific devices (by IP, IPv6 or MAC) to use proxy and DNS. Example: Apple TV, game console, specific PC."
msgstr "强制指定设备（按 IP、IPv6 或 MAC）使用代理和 DNS。例如：Apple TV、游戏机、特定电脑。"

msgid "Only intercept traffic entering from these interfaces. nftables: iifname @lan_inbound_device. IMPORTANT: never select wan or loopback."
msgstr "仅拦截从这些接口进入的流量。nftables：iifname @lan_inbound_device。重要：切勿选择 wan 或 loopback。"

msgid "Enable transparent proxy for devices on the local network."
msgstr "为局域网设备启用透明代理。"

msgid "Enable proxy for devices not explicitly configured. nftables: jump lan_tproxy or lan_redirect."
msgstr "对未单独配置的设备启用代理。nftables：jump lan_tproxy 或 lan_redirect。"

msgid "Enable DNS hijacking for devices not explicitly configured. Prevents smart TVs and phones from using public DNS servers."
msgstr "对未单独配置的设备启用 DNS 劫持。防止智能电视和手机使用公共 DNS。"

msgid "Enable proxy for users not explicitly configured. nftables: jump router_tproxy or router_redirect."
msgstr "对未单独配置的用户启用代理。nftables：jump router_tproxy 或 router_redirect。"

msgid "Enable DNS hijacking for users not explicitly configured in access control lists. nftables: jump router_dns_hijack."
msgstr "对访问控制列表中未单独配置的用户启用 DNS 劫持。nftables：jump router_dns_hijack。"

msgid "Enable proxy for traffic originating from the router itself (e.g. opkg, curl, Docker containers)."
msgstr "为路由器自身产生的流量启用代理（如 opkg、curl、Docker 容器）。"

msgid "Enable or disable the entire Nikki proxy subsystem."
msgstr "启用或禁用整个 Nikki 代理子系统。"

msgid "Private and internal IPv4 addresses that always bypass proxy. nftables: ip daddr @reserved_ip counter return."
msgstr "始终绕过代理的 IPv4 私网/内网地址。nftables：ip daddr @reserved_ip counter return。"

msgid "Private and internal IPv6 addresses that always bypass proxy. nftables: ip6 daddr @reserved_ip6 counter return."
msgstr "始终绕过代理的 IPv6 私网/内网地址。nftables：ip6 daddr @reserved_ip6 counter return。"

msgid "Packets with these DSCP values bypass proxy. Advanced usage for QoS integration. nftables: ip dscp @bypass_dscp return."
msgstr "具有这些 DSCP 值的数据包绕过代理。用于 QoS 集成的高级用法。nftables：ip dscp @bypass_dscp return。"

msgid "Packets already marked with these fwmarks bypass proxy. Useful for Docker, WireGuard or other VPN coexistence. nftables: meta mark & mask == fwmark return."
msgstr "已被这些 fwmark 标记的数据包绕过代理。适用于 Docker、WireGuard 或其他 VPN 共存场景。nftables：meta mark & mask == fwmark return。"

msgid "Only proxy traffic destined to these TCP ports. nftables: meta l4proto . th dport != @proxy_dport return."
msgstr "仅代理发往这些 TCP 端口的流量。nftables：meta l4proto . th dport != @proxy_dport return。"

msgid "Only proxy traffic destined to these UDP ports. nftables: meta l4proto . th dport != @proxy_dport return."
msgstr "仅代理发往这些 UDP 端口的流量。nftables：meta l4proto . th dport != @proxy_dport return。"

msgid "Skip proxy for Chinese mainland IPv4 addresses. nftables: ip daddr @china_ip counter return. Highly recommended for better performance."
msgstr "对中国大陆 IPv4 地址绕过代理。nftables：ip daddr @china_ip counter return。强烈推荐以提升性能。"

msgid "Skip proxy for Chinese mainland IPv6 addresses. nftables: ip6 daddr @china_ip6 counter return."
msgstr "对中国大陆 IPv6 地址绕过代理。nftables：ip6 daddr @china_ip6 counter return。"

msgid "Redirect ICMP Echo Request to Fake-IP range. Prevents Fake-IP detection by ping probes."
msgstr "将 ICMP Echo Request 重定向到 Fake-IP 网段。防止通过 ping 探测出 Fake-IP。"

msgid "Intercept IPv4 UDP/53 DNS requests and redirect them to Nikki built-in DNS. Prevents DNS leaks."
msgstr "拦截 IPv4 UDP/53 DNS 请求并重定向到 Nikki 内置 DNS。防止 DNS 泄漏。"

msgid "Intercept IPv6 UDP/53 DNS requests. Critical to avoid IPv6 DNS leaks when IPv6 proxy is enabled."
msgstr "拦截 IPv6 UDP/53 DNS 请求。启用 IPv6 代理时，避免 IPv6 DNS 泄漏至关重要。"

msgid "Apply proxy rules to IPv4 traffic. nftables uses meta nfproto ipv4 to match."
msgstr "对 IPv4 流量应用代理规则。nftables 使用 meta nfproto ipv4 匹配。"

msgid "Apply proxy rules to IPv6 traffic. Requires proper IPv6 routing. Disable if your ISP has unstable IPv6."
msgstr "对 IPv6 流量应用代理规则。需要正确的 IPv6 路由。若运营商 IPv6 不稳定请禁用。"

msgid "Idle timeout for TUN connections in seconds. Connections with no data for this long will be closed."
msgstr "TUN 连接空闲超时时间（秒）。超过此时长无数据的连接将被关闭。"

msgid "Interval in seconds for cleaning up dead TUN connections."
msgstr "清理失效 TUN 连接的时间间隔（秒）。"

msgid "Whether this whitelist entry should also hijack DNS."
msgstr "此白名单条目是否同时劫持 DNS。"

msgid "Whether this whitelist entry should be proxied."
msgstr "此白名单条目是否走代理。"

