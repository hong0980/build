#!/usr/bin/ucode
// https://ucode.mein.io/module-fs.html
'use strict';
import { cursor } from 'uci';
import { access, popen, writefile, chmod, mkdir, readfile, unlink } from 'fs';
import {
	get_users, get_groups, get_cgroups, load_profile, shellQuote, run
} from '/etc/nikki/ucode/include.uc';

const CACHE_DIR    = '/etc/nikki/run/core';
const CONFIG_PATH  = '/etc/nikki/run/config.yaml';
const DEFAULT_UA   = 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36';

const uci          = cursor();
const github_token = trim(uci.get('nikki', 'config', 'github_token') || '');

function call_controller(method, path, query, body) {
	let result = { success: false, status: 0, data: null, message: null };

	const profile        = load_profile();
	const api_secret     = profile['secret'];
	const api_listen     = profile['external-controller'];
	const api_tls_listen = profile['external-controller-tls'];

	if (!api_listen && !api_tls_listen)
		return { message: 'not found: listen', status: 'error' };

	const protocol = api_tls_listen ? 'https' : 'http';
	const url      = `${api_tls_listen || api_listen}${path}`;

	let cmd = `curl -sSk --proto-default ${shellQuote(protocol)} -X ${shellQuote(method)} -H ${shellQuote('Authorization: Bearer ' + api_secret)}`;
	if (query) cmd += ` --url-query ${shellQuote(query)}`;
	if (body)  cmd += ` -H ${shellQuote('Content-Type: application/json')} -d ${shellQuote(body)}`;
	cmd += ` -w ${shellQuote('\n__HTTP_CODE__:%{http_code}')} ${shellQuote(url)} 2>&1`;

	const proc = popen(cmd, 'r');
	if (!proc) return { message: 'popen failed', status: 'error' };

	const process   = proc.read('all') || '';
	const exit_code = proc.close();

	if (!process && exit_code != 0)
		return { message: `curl failed (exit ${exit_code})`, status: 'error' };

	const marker = '\n__HTTP_CODE__:';
	const idx    = index(process, marker, true);

	let bodyText = process;
	let httpCode = 0;

	if (idx !== -1) {
		bodyText = trim(substr(process, 0, idx));
		httpCode = +trim(substr(process, idx + length(marker))) || 0;
	}

	result.status  = httpCode;
	result.success = (httpCode >= 200 && httpCode < 300);

	if (!result.success) {
		result.message = bodyText || `HTTP ${httpCode} (exit ${exit_code})`;
		return result;
	}

	if (bodyText) {
		try { result.data = json(bodyText); }
		catch (e) { result.data = bodyText; }
	}
	return result;
}

function get_core_url_call(req) {
	const arch      = req.args?.arch;
	const core_type = req.args?.core_type;

	if (!core_type || !arch)
		return { status: 'error', message: 'missing params' };

	if (core_type == 'smart') {
		return {
			status: 'ok',
			url   : `https://raw.githubusercontent.com/vernesong/OpenClash/core/dev/smart/clash-${arch}-compatible.tar.gz`
		};
	};

	const api_map = {
		meta : 'https://api.github.com/repos/MetaCubeX/mihomo/releases/latest',
		alpha: 'https://api.github.com/repos/MetaCubeX/mihomo/releases/tags/Prerelease-Alpha'
	};

	const api_url = api_map[core_type];
	if (!api_url)
		return { status: 'error', message: 'invalid core type' };

	let cmd = 'curl -sL --max-time 15';
	if (github_token)
		cmd += ' -H ' + shellQuote('Authorization: Bearer ' + github_token);
	cmd += ' ' + shellQuote(api_url);

	const api_out = run(cmd);
	if (!api_out)
		return { status: 'error', message: 'failed to fetch release info (empty response)' };

	let info;
	try {
		info = json(api_out);
	} catch (e) {
		const preview = length(api_out) > 200 ? substr(api_out, 0, 200) + '...' : api_out;
		return { status: 'error', message: `json parse failed: ${preview}` };
	};

	if (info.message && !info.tag_name && !info.assets)
		return { status: 'error', message: `github api error: ${info.message}` };

	if (core_type == 'meta') {
		const tag = info.tag_name;
		if (!tag) {
			const keys = [];
			for (let k in info) push(keys, k);
			return { status: 'error', message: `no tag found, keys: ${join(keys, ',')}` };
		}
		const filename = `mihomo-${arch}-compatible-${tag}.gz`;
		return {
			status: 'ok',
			url   : `https://github.com/MetaCubeX/mihomo/releases/download/${tag}/${filename}`
		};
	};

	const assets = info.assets;
	if (!assets || !length(assets))
		return { status: 'error', message: 'no assets found' };

	const prefix = `mihomo-${arch}`;
	let found    = null;

	for (let i = 0; i < length(assets); i++) {
		const name = assets[i].name;
		if (index(name, prefix) < 0 || index(name, '.gz') < 0)
			continue;
		if (index(name, 'compatible') >= 0) {
			found = assets[i];
			break;
		}
		if (index(name, `${prefix}-alpha-`) >= 0) {
			found = assets[i];
			continue;
		}
		if (!found) found = assets[i];
	};

	if (!found) return { status: 'error', message: `no matching asset for ${arch}` };

	return {
		status: 'ok',
		url   : found.browser_download_url
	};
}

function cache_core_call(req) {
	const arch        = req.args?.arch;
	const core_type   = req.args?.core_type;
	const out_name    = `${core_type}-mihomo`;
	const final_out   = `${CACHE_DIR}/${out_name}`;
	const status_file = `/tmp/nikki_dl_${core_type}.status`;
	const log_file    = `/tmp/nikki_dl_${core_type}.log`;

	if (!core_type || !arch)
		return { status: 'error', message: 'missing params' };

	if (access(status_file)) {
		const st = trim(readfile(status_file) || '');
		if (st == 'downloading')
			return { status: 'pending', message: 'download in progress' };
	};

	let core_info;
	try {
		core_info = get_core_url_call({ args: { core_type, arch } });
	} catch (e) {
		return { status: 'error', message: `${e.message || e}` };
	};

	if (core_info?.status != 'ok')
		return { status: 'error', message: core_info?.message || 'no core info' };

	const archive_name       = core_type == 'smart' ? 'mihomo.tar.gz' : 'mihomo.gz';
	const archive_cache_name = `${core_type}-${archive_name}`;
	const archive_fullpath   = `${CACHE_DIR}/${archive_cache_name}`;

	unlink(status_file);
	unlink(log_file);
	unlink(archive_fullpath);
	unlink(`${CACHE_DIR}/${out_name}.tmp`);

	if (!access(CACHE_DIR)) mkdir(CACHE_DIR);

	writefile(status_file, 'downloading');

	const istargz = core_type == 'smart' ? '1' : '0';
	const url     = shellQuote(core_info.url);
	const afile   = shellQuote(archive_fullpath);
	const tfile   = shellQuote(`${CACHE_DIR}/${out_name}.tmp`);
	const ffile   = shellQuote(final_out);
	const sfile   = shellQuote(status_file);
	const lfile   = shellQuote(log_file);

	const cmd = `( \
echo "[$(date '+%Y-%m-%d %H:%M:%S')] start" >> ${lfile}; \
wget -q --timeout=60 -O ${afile} ${url} 2>>${lfile}; \
if [ -s ${afile} ]; then \
	echo "[$(date '+%Y-%m-%d %H:%M:%S')] download ok" >> ${lfile}; \
	rm -f ${tfile}; \
	if [ "${istargz}" = "1" ]; then \
		tmpdir=/tmp/mihomo_extract_$$; \
		rm -rf "$tmpdir" && mkdir -p "$tmpdir"; \
		echo "[$(date '+%Y-%m-%d %H:%M:%S')] extracting" >> ${lfile}; \
		if tar -xzf ${afile} -C "$tmpdir" 2>>${lfile}; then \
			found=$(ls -1 "$tmpdir" 2>/dev/null | head -1); \
			echo "[$(date '+%Y-%m-%d %H:%M:%S')] found=$found" >> ${lfile}; \
			if [ -n "$found" ] && [ -r "$tmpdir/$found" ]; then \
				cp -f "$tmpdir/$found" ${tfile}; \
			fi; \
		fi; \
		rm -rf "$tmpdir"; \
	else \
		echo "[$(date '+%Y-%m-%d %H:%M:%S')] gunzip" >> ${lfile}; \
		gunzip -c ${afile} > ${tfile} 2>>${lfile}; \
	fi; \
	if [ -r ${tfile} ]; then \
		chmod 755 ${tfile}; \
		mv -f ${tfile} ${ffile}; \
		rm -f ${afile}; \
		echo "done" > ${sfile}; \
		echo "[$(date '+%Y-%m-%d %H:%M:%S')] done" >> ${lfile}; \
	else \
		echo "[$(date '+%Y-%m-%d %H:%M:%S')] error: tmp file missing" >> ${lfile}; \
		echo "error: tmp file missing" > ${sfile}; \
	fi; \
else \
	echo "[$(date '+%Y-%m-%d %H:%M:%S')] error: download failed" >> ${lfile}; \
	echo "error: download failed" > ${sfile}; \
fi \
) >> ${lfile} 2>&1 &`;

	system(['sh', '-c', cmd]);
	return { status: 'pending', message: 'download started in background' };
}

function switch_core_call(req) {
	const arch      = req.args?.arch;
	const core_type = req.args?.core_type;
	if (!core_type) return { status: 'error', message: 'missing core_type' };
	const final_out = `${CACHE_DIR}/${core_type}-mihomo`;

	if (!access(final_out)) {
		const cache = cache_core_call({ args: { core_type, arch } });
		if (!cache || cache.status == 'error')
			return { status: 'error', message: cache?.message || `cached binary not found: ${final_out}` };

		return { status: 'pending', message: 'downloading core' };
	};

	uci.set('nikki', 'config', 'core', core_type);
	uci.commit('nikki');
	system(['service', 'nikki', 'restart']);

	return { status: 'ok' };
}

const methods = {
	set_commit: {
		args: { config: 'config', section: 'section', option: 'option', value: 'value' },
		call: function (req) {
			const config  = req.args?.config;
			const section = req.args?.section;
			const option  = req.args?.option;
			const value   = req.args?.value;

			if (!uci.get(config, section))
				return { status: 'error', message: 'section not found' };

			uci.set(config, section, option, value);
			uci.commit(config);
			return { status: 'ok' };
		}
	},

	connection_check: {
		args: { url: 'url' },
		call: function (req) {
			if (!req.args?.url)
				return { httpcode: null, error: 'illegal url' };

			const out = run(`curl -s -o /dev/null -L -w '%{http_code} %{time_total}' --max-time 3 ${shellQuote(req.args.url)}`);
			if (!out) return { httpcode: '-1', elapsed_ms: -1 };

			const parts      = split(out, ' ');
			const httpcode   = parts[0] || '-1';
			const elapsed_ms = parts[1] ? int(+parts[1] * 1000) : -1;
			return { httpcode, elapsed_ms };
		}
	},

	update_ui: {
		args: { url: 'url', name: 'name' },
		call: function (req) {
			const url        = req.args?.url;
			const name       = req.args?.name;
			const profile    = load_profile();
			const secret     = profile['secret'];
			const listen     = profile['external-controller'];
			const tls_listen = profile['external-controller-tls'];

			if (!listen && !tls_listen)
				return { status: 'error', message: 'invalid listen' };

			if (!url || !name
				|| !match(name, /^[A-Za-z0-9_-]+$/)
				|| match(url, /['"`$\\;&|<>(){}\n]/)
			) { return { status: 'error', message: 'invalid url/name' }; }

			const yq_out = run(`yq -Mi '.["external-ui-url"]="${url}" | .["external-ui-name"]="${name}"' ${CONFIG_PATH} 2>&1`);
			if (yq_out)
				return { status: 'error', message: `yq: ${yq_out}` };

			const reload = call_controller('PUT', '/configs?force=true', null, `{"path": "${CONFIG_PATH}", "payload": ""}`);
			if (!reload.success)
				return { status: 'error', message: `reload: ${reload.message || reload.data || 'unknown'}` };

			function do_upgrade() {
				return call_controller('POST', '/upgrade/ui');
			}

			const DELAYS = [2, 2, 2];
			let result   = null;

			for (let i = 0; i < length(DELAYS); i++) {
				system(['sleep', '' + DELAYS[i]]);
				result = do_upgrade();
				if (result?.success) break;
			};

			return result?.success
				? { status: 'ok' }
				: { status: 'error', message: result?.message || 'please retry' };
		}
	},

	download_file: {
		args: {
			url: 'url', path: 'path', filename: 'filename',
			chmod: 'chmod', ua: 'ua', secret: 'secret', headers: 'headers'
		},
		call: function (req) {
			const url      = req.args?.url;
			let   path     = req.args?.path;
			const do_chmod = req.args?.chmod;
			const filename = req.args?.filename;
			const ua       = req.args?.ua || DEFAULT_UA;
			const secret   = req.args?.secret;
			let   headers  = req.args?.headers;

			if (!url)  return { status: 'error', message: 'missing url' };
			if (!path) return { status: 'error', message: 'missing path' };
			if (match(url, /['"`$\\;&|<>(){}\n]/))
				return { status: 'error', message: 'invalid url' };

			path = filename ? `${path}/${filename}` : path;

			let cmd = `curl -SsL --connect-timeout 15 --max-time 120 --retry 3 --retry-delay 2 --retry-max-time 180 -o ${shellQuote(path)} -A ${shellQuote(ua)}`;
			if (secret) cmd += ` -H ${shellQuote(secret)}`;
			if (headers) {
				const headerList = split(headers, '|');
				for (let i = 0; i < length(headerList); i++) {
					if (headerList[i])
						cmd += ` -H ${shellQuote(trim(headerList[i]))}`;
				};
			};
			cmd += ` ${shellQuote(url)}`;

			const out = run(cmd);
			if (access(path)) {
				if (do_chmod) chmod(path, 493);
				return { status: 'ok', path };
			};
			return { status: 'error', message: out || 'download failed' };
		}
	},

	version: {
		call: function () {
			let app  = null, core = null;

			if (access('/usr/bin/apk')) {
				app = run(`apk list -I luci-app-nikki | sed -nr 's/.*nikki-(.*)-.*noarch.*/\\1/p'`);
			} else if (access('/bin/opkg')) {
				app = run(`opkg list-installed luci-app-nikki | sed -nr 's/.*nikki - (.*)-.*/\\1/p'`);
			};

			core = run(`/etc/nikki/run/mihomo -v | grep Mihomo | cut -d " " -f 3`);
			return { app, core };
		}
	},

	check_download: {
		args: { core_type: 'core_type' },
		call: function(req) {
			const core_type   = req.args?.core_type;
			const status_file = `/tmp/nikki_dl_${core_type}.status`;
			const final_out   = `${CACHE_DIR}/${core_type}-mihomo`;

			if (!core_type)
				return { status: 'error', message: 'missing core_type' };

			if (access(status_file)) {
				const st = trim(readfile(status_file) || '');

				if (st == 'done')
					return { status: 'ok', path: final_out, message: 'complete' };
				else if (st == 'downloading')
					return { status: 'pending', message: 'in progress' };
				else if (substr(st, 0, 6) == 'error:')
					return { status: 'error', message: substr(st, 6) };

				return { status: 'unknown', message: st };
			}

			if (access(final_out))
				return { status: 'ok', path: final_out, message: 'already exists' };

			return { status: 'unknown', message: 'no task found' };
		}
	},

	profile: {
		args: { defaults: {} },
		call: function (req) {
			const defaults    = req.args?.defaults ?? {};
			const tmpFilepath = '/var/run/nikki/profile.json';

			if (access(CONFIG_PATH)) {
				writefile(tmpFilepath, defaults);
				const process = run(`yq -Mpy -o json eval-all 'select(fi == 0) *? select(fi == 1)' ${tmpFilepath} ${CONFIG_PATH}`);
				if (process) return json(process);
			}
			return {};
		}
	},

	update_subscription: {
		args: { section_id: 'section_id' },
		call: function (req) {
			const section_id = req.args?.section_id;
			const success    = section_id
				? system(['service', 'nikki', 'update_subscription', section_id]) == 0
				: false;
			return { success };
		}
	},

	api: {
		args: { method: 'method', path: 'path', query: 'query', body: 'body' },
		call: function (req) {
			return call_controller(
				req.args?.method || 'GET',
				req.args?.path   || '/',
				req.args?.query,
				req.args?.body
			);
		}
	},

	get_identifiers: {
		call: function () {
			const users   = filter(get_users(),   (x) => x != '');
			const groups  = filter(get_groups(),  (x) => x != '');
			const cgroups = filter(get_cgroups(), (x) => x != '' && index(x, 'services/nikki') < 0);
			return { users, groups, cgroups };
		}
	},

	debug: {
		call: function () {
			const success = system(['sh', '-c', '/etc/nikki/scripts/debug.sh > /var/log/nikki/debug.log']) == 0;
			return { success };
		}
	},

	get_core_url: {
		args: { core_type: 'core_type', arch: 'arch' },
		call: get_core_url_call
	},

	cache_core: {
		args: { core_type: 'core_type', arch: 'arch' },
		call: cache_core_call
	},

	switch_core: {
		args: { core_type: 'core_type', arch: 'arch' },
		call: switch_core_call
	}
};

return { 'luci.nikki': methods };
