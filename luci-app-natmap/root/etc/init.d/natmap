#!/bin/sh /etc/rc.common

. "${IPKG_INSTROOT}/lib/functions/network.sh"

START=97
STOP=90
USE_PROCD=1

[ -x "$(command -v nft)" ] && FW='fw4' || FW='fw3'
STATUS_PATH="/var/run/natmap"
LOG_FILE="/var/log/natmap.log"
config_load natmap

boot() {
	sleep "$(uci -q get natmap.@global[0].boot_delay || echo 0)"
	start
}

# define global var: DEF_WAN DEF_WAN6 NIC_* NIC6_*
define_nic() {
	local max_wait="${1:-20}" step="${2:-2}" waited=0
	local dev dev_path ipv4_sub ipv6_sub addr
	local best_ipv6 fallback_ula fallback_ll var_name

	while :; do
		for v in $(set | sed -n 's/^\(NIC6\{0,1\}_[A-Za-z0-9_]*\)=.*/\1/p'); do
			unset "$v"
		done
		DEF_WAN=""
		DEF_WAN6=""
		network_flush_cache

		for dev_path in /sys/class/net/*; do
			[ -e "$dev_path" ] || continue
			dev="${dev_path##*/}"
			var_name="${dev//[[:punct:]]/_}"

			ipv4_sub=$(ip -o -4 addr show dev "$dev" 2>/dev/null | awk '{print $4; exit}')
			[ -n "$ipv4_sub" ] && eval "NIC_${var_name}=\"\$ipv4_sub\""

			ipv6_sub=$(ip -o -6 addr show dev "$dev" 2>/dev/null | awk '!/deprecated/ {print $4}')
			best_ipv6=""
			fallback_ula=""
			fallback_ll=""

			for addr in $ipv6_sub; do
				case "$addr" in
					::1/*) continue ;;
					fe[89aAbB][0-9a-fA-F]*:*) [ -z "$fallback_ll" ] && fallback_ll="$addr" ;;
					f[cCdD]*:*) [ -z "$fallback_ula" ] && fallback_ula="$addr" ;;
					*) best_ipv6="$addr"; break ;;
				esac
			done

			[ -z "$best_ipv6" ] && best_ipv6="${fallback_ula:-$fallback_ll}"
			[ -n "$best_ipv6" ] && eval "NIC6_${var_name}=\"\$best_ipv6\""
		done
		network_find_wan  DEF_WAN
		network_find_wan6 DEF_WAN6
		[ -n "$DEF_WAN$DEF_WAN6" ] && return 0
		[ "$waited" -lt "$max_wait" ] || return 1
		sleep "$step"
		waited=$((waited + step))
	done
}

load_interfaces() {
	local bind_ifname enable
	config_get bind_ifname "$1" bind_ifname
	config_get_bool enable "$1" enable 0
	[ "$enable" = 1 ] && interfaces=" $(uci -q show network | grep "device='$bind_ifname'" | cut -f2 -d'.') $interfaces"
}

err_msg__empty() {
	>&2 echo "$(basename "$0"): section $1 option $2 cannot be empty"
}

# define global var: GLOBAL_*
define_global() {
	[ "$2" = "0" ] || { >&2 echo "$(basename "$0"): section $1 validation failed"; return 1; }
	local error=0
	local v ucivv="enable def_tcp_stun def_udp_stun def_http_server def_fwmark_value def_tcp_interval def_udp_interval def_udp_stun_cycle"
	for v in $ucivv; do
		if [ -z "$(config_get "$1" "$v")" -a "$v" != "def_fwmark_value" ]; then
			err_msg__empty "$1" "$v"
			let error++
		fi
		eval "GLOBAL_$v=\$$v"
	done

	[ "$error" -gt 0 ] && return 1 || return 0
}

validate_section_global() {
	uci_load_validate natmap global "$1" "$2" \
		'enable:bool:0' \
		'def_tcp_stun:string' \
		'def_udp_stun:string' \
		'def_http_server:string' \
		'def_fwmark_value:string' \
		'def_tcp_interval:and(uinteger, min(1)):30' \
		'def_udp_interval:and(uinteger, min(1)):15' \
		'def_udp_stun_cycle:uinteger:5' \
		'test_port:and(port, min(1))'
}

validate_section_natmap() {
	uci_load_validate natmap natmap "$1" "$2" \
		'enable:bool:0' \
		'interval:and(uinteger, min(1))' \
		'stun_cycle:uinteger' \
		'stun_server:string' \
		'http_server:string' \
		'fwmark_value:string' \
		'comment:string' \
		'udp_mode:bool:0' \
		'family:or("ipv4", "ipv6"):ipv4' \
		'bind_ifname:network' \
		'port:or(port, portrange)' \
		'port_pointer:bool:0' \
		'forward:bool:0' \
		'forward_mode:or("dnat", "via"):via' \
		'natloopback:bool:1' \
		'forward_congestion:string' \
		'forward_timeout:and(uinteger, min(1))' \
		'forward_target:or(hostname,ipaddr(1))' \
		'forward_port:port' \
		'refresh:bool:0' \
		'clt_type:string' \
		'clt_scheme:or("http", "https"):http' \
		'clt_web_port:and(port, min(1))' \
		'clt_username:string' \
		'clt_password:string' \
		'notify_enable:bool:0' \
		'notify_script:file' \
		'notify_tokens:list(string)' \
		'notify_custom_domain:hostname' \
		'notify_text:string' \
		'ddns_enable:bool:0' \
		'ddns_script:file' \
		'ddns_tokens:list(string)' \
		'ddns_a:hostname' \
		'ddns_aaaa:hostname' \
		'ddns_txt:hostname' \
		'ddns_txt_content:string' \
		'ddns_srv:hostname' \
		'ddns_srv_serv:string' \
		'ddns_srv_proto:string:tcp' \
		'ddns_srv_target:hostname' \
		'ddns_srv_priority:range(0, 65535):0' \
		'ddns_srv_weight:range(0, 65535):65535' \
		'ddns_https:hostname' \
		'ddns_https_target:or(".", hostname):.' \
		'ddns_https_svcparams:string:alpn="h2,http/1.1"' \
		'ddns_https_priority:range(1, 65535):1' \
		'custom_script:file'
}

hostname_match() {
	[ "$#" -ge 1 ] || return 1
	printf '%s\n' "$1" | grep -E "^[[:alnum:]][-[:alnum:]]{0,62}(\.[[:alnum:]][-[:alnum:]]{0,62})*\.?$"
}

ip_match() {
	[ "$#" -ge 2 ] || return 1
	local _family="$1"
	local _ip="$2"

	case "$_family" in
		ipv4)
			printf '%s\n' "$_ip" | grep -E "^((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)$"
			;;
		ipv6)
			printf '%s\n' "$_ip" | grep -E "^(([[:xdigit:]]{1,4}:){7}[[:xdigit:]]{1,4}|([[:xdigit:]]{1,4}:){1,7}:|([[:xdigit:]]{1,4}:){1,6}:[[:xdigit:]]{1,4}|([[:xdigit:]]{1,4}:){1,5}(:[[:xdigit:]]{1,4}){1,2}|([[:xdigit:]]{1,4}:){1,4}(:[[:xdigit:]]{1,4}){1,3}|([[:xdigit:]]{1,4}:){1,3}(:[[:xdigit:]]{1,4}){1,4}|([[:xdigit:]]{1,4}:){1,2}(:[[:xdigit:]]{1,4}){1,5}|[[:xdigit:]]{1,4}:(:[[:xdigit:]]{1,4}){1,6}|:((:[[:xdigit:]]{1,4}){1,7}|:)|fe80:(:[[:xdigit:]]{0,4}){0,4}%[a-zA-Z0-9_.-]+|::(ffff(:0{1,4}){0,1}:){0,1}((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)|([[:xdigit:]]{1,4}:){1,4}:((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?))$"
			;;
	esac
}

fwmark_match() {
	printf '%s\n' "$1" | grep -E '^(0|0x[[:xdigit:]]+|[1-9][0-9]*|0[0-7]+)$'
}

natmap_instance() {
	procd_open_instance "$1"
	procd_set_param command /bin/sh -c '
		log="'"$LOG_FILE"'"; mkdir -p "$(dirname "$log")";
		fifo="/tmp/natmap_$$.fifo"; rm -f "$fifo"; mkfifo "$fifo" || exit 1
		(
			cnt=0
			while IFS= read -r line || [ -n "$line" ]; do
				printf "[%s][%-12s] %s\n" "$(date "+%Y-%m-%d %H:%M:%S")" "'"${comment:0:12}"'" "$line" >> "$log"
				cnt=$((cnt + 1))
				if [ "$cnt" -ge 200 ]; then
					cnt=0
					[ "$(wc -c < "$log" 2>/dev/null || echo 0)" -gt 524288 ] && tail -n 500 "$log" > "${log}.$$.tmp" && mv "${log}.$$.tmp" "$log"
				fi
			done < "$fifo"
			rm -f "$fifo"
		) &
		exec "$0" "$@" > "$fifo" 2>&1
	' /usr/bin/natmap

	procd_append_param command \
		${interval:+-k "$interval"} \
		${stun_cycle:+-c "$stun_cycle"} \
		${stun_server:+-s "$stun_server"} \
		${http_server:+-h "$http_server"} \
		${fwmark_value:+-f "$fwmark_value"} \
		${port:+-b "$([ "$port_pointer" = 1 ] && echo "${port/-/\~}" || echo "$port")"}

	[ "$family" = "ipv4" ] && procd_append_param command -4
	[ "$family" = "ipv6" ] && procd_append_param command -6
	[ "$udp_mode" = 1 ]    && procd_append_param command -u

	procd_set_param netdev "br-lan"
	if [ -n "$bind_ifname" ]; then
		procd_append_param command -i "$bind_ifname"
		procd_append_param netdev "$bind_ifname"
	else
		local ifname
		network_get_device ifname "$DEF_WAN"  && procd_append_param netdev "$ifname"
		network_get_device ifname "$DEF_WAN6" && procd_append_param netdev "$ifname"
	fi

	if [ "$forward" = 1 -a "$forward_mode" = "via" -a -n "$forward_target" ]; then
		procd_append_param command -t "$forward_target" -p "$forward_port" \
			${forward_congestion:+-C "$forward_congestion"} \
			${forward_timeout:+-T "$forward_timeout"}
	fi

	procd_set_param env "SECTIONID=$1" "COMMENT=$comment"

	if [ "$forward" = 1 ]; then
		[ "$forward_port" = 0 -a "$forward_mode" = "dnat" ] && procd_append_param env "RWFW=1"
		if [ "$refresh" = 1 ]; then
			json_init
			json_add_int    web_port "$clt_web_port"
			json_add_string scheme "$clt_scheme"
			json_add_string host "$forward_target"
			json_add_string username "$clt_username"
			json_add_string password "$clt_password"
			procd_append_param env "CLIENT=$clt_type" "REFRESH_PARAM=$(json_dump)"
		fi
	fi

	if [ "$notify_enable" = 1 ]; then
		json_init
		json_add_string custom_domain "$notify_custom_domain"
		json_add_string text "$notify_text"
		json_add_string tokens "$notify_tokens"
		procd_append_param env "NOTIFY=$notify_script" "NOTIFY_PARAM=$(json_dump)"
	fi

	if [ "$ddns_enable" = 1 ]; then
		json_init
		json_add_string tokens "$ddns_tokens"
		[ "$family" = "ipv4" ] && json_add_string hostype "A"    && json_add_string host "$ddns_a"
		[ "$family" = "ipv6" ] && json_add_string hostype "AAAA" && json_add_string host "$ddns_aaaa"
		if [ -n "$ddns_txt" ]; then
			json_add_string txt "$ddns_txt"
			json_add_string txt_content "$ddns_txt_content"
		fi
		if [ -n "$ddns_srv" ]; then
			json_add_string srv "$ddns_srv"
			json_add_string srv_serv "$ddns_srv_serv"
			json_add_string srv_proto "$ddns_srv_proto"
			json_add_string srv_target "$ddns_srv_target"
			json_add_int    srv_priority "$ddns_srv_priority"
			json_add_int    srv_weight "$ddns_srv_weight"
		fi
		if [ -n "$ddns_https" ]; then
			json_add_string https "$ddns_https"
			json_add_string https_target "$ddns_https_target"
			json_add_string https_svcparams "$ddns_https_svcparams"
			json_add_int    https_priority "$ddns_https_priority"
		fi
		procd_append_param env "DDNS=$ddns_script" "DDNS_PARAM=$(json_dump)"
	fi

	[ -n "$custom_script" ] && procd_append_param env "CUSTOM_SCRIPT=$custom_script"
	procd_append_param command -e /etc/natmap/scripts/update.sh

	procd_set_param respawn 300 5 5

	procd_open_data
	json_add_array firewall
	if [ "$forward" = 1 -a "$forward_mode" = "dnat" ]; then
		json_add_object ''
		json_add_string type redirect
		json_add_string target DNAT
		json_add_string name "$1"
		json_add_string family "$family"
		json_add_string proto "$proto"
		json_add_string src "$($FW -q device "$bind_ifname")"
		json_add_string src_dport "$port"
		json_add_string dest_ip "$forward_target"
		if [ -n "$PUBPORT" ]; then
			json_add_string dest_port "$PUBPORT"
			unset PUBPORT
		else
			json_add_string dest_port "$forward_port"
		fi
		json_add_boolean reflection "$natloopback"
		json_close_object
	elif { [ "$forward" = 1 -a "$forward_mode" = "via" ]; } || [ "$forward" = 0 ]; then
		json_add_object ''
		json_add_string type rule
		json_add_string target ACCEPT
		json_add_string name "$1"
		json_add_string family "$family"
		json_add_string proto "$proto"
		json_add_string direction in
		json_add_string src "$($FW -q device "$bind_ifname")"
		json_add_string dest_port "$port"
		json_close_object
	fi
	json_close_array
	procd_close_data
	procd_close_instance
}

clear_status_files() {
	local f sid="$1"
	mkdir -p "$STATUS_PATH" 2>/dev/null
	(
		cd "$STATUS_PATH" || exit 1
		if [ -n "$sid" ]; then
			for f in *.json; do
				[ -e "$f" ] || continue
				[ "$(jsonfilter -q -i "$f" -e '@.sid')" = "$sid" ] || continue
				rm -f "$f"
				break
			done
		else
			find . -type f -print0 | xargs -0 rm -f --
		fi
	)
}

launcher() {
	[ "$2" = 0 ] || { >&2 echo "$(basename "$0"): section $1 validation failed"; return 1; }
	[ "$enable" = 0 ] && return 0

	local interval stun_cycle stun_server http_server
	if [ "$udp_mode" = 1 ]; then
		interval=${interval:-$GLOBAL_def_udp_interval}
		stun_cycle=${stun_cycle:-$GLOBAL_def_udp_stun_cycle}
		stun_server=${stun_server:-$GLOBAL_def_udp_stun}
		http_server=''
	else
		interval=${interval:-$GLOBAL_def_tcp_interval}
		stun_cycle=''
		stun_server=${stun_server:-$GLOBAL_def_tcp_stun}
		http_server=${http_server:-$GLOBAL_def_http_server}
	fi
	local fwmark_value=${fwmark_value:-$GLOBAL_def_fwmark_value}

	local error=0 proto ifname bind_ip lan_addr
	[ "$udp_mode" = 1 ] && proto=udp || proto=tcp
	case "$family" in
		ipv4) network_get_device ifname "$DEF_WAN" ;;
		ipv6) network_get_device ifname "$DEF_WAN6" ;;
	esac

	local bind_ifname=${bind_ifname:-$ifname}
	if [ -z "$bind_ifname" ]; then
		>&2 echo "$(basename "$0"): section $1 option bind_ifname parsing failed, there may be no $family network connection"
		let error++
	fi

	case "$family" in
		ipv4)
			eval "bind_ip=\"\${NIC_${bind_ifname//[[:punct:]]/_}%/*}\""
			lan_addr="${NIC_br_lan%/*}"
			;;
		ipv6)
			eval "bind_ip=\"\${NIC6_${bind_ifname//[[:punct:]]/_}%/*}\""
			lan_addr="${NIC6_br_lan%/*}"
			;;
	esac

	if [ -z "$bind_ip" ]; then
		>&2 echo "$(basename "$0"): section $1 option bind_ip parsing failed, there may be no $family network connection"
		let error++
	fi

	if [ -z "$port" ]; then
		err_msg__empty "$1" port
		let error++
	elif ! printf '%s\n' "$port" | grep -qE '^([1-9]\d*)(-([1-9]\d*))?$'; then
		>&2 echo "$(basename "$0"): section $1 option port '$port' is invalid"
		let error++
	fi

	if [ -n "$fwmark_value" -a -z "$(fwmark_match "$fwmark_value")" ]; then
		>&2 echo "$(basename "$0"): section $1 option fwmark_value '$fwmark_value' is invalid"
		let error++
	fi

	## forward
	if [ "$forward" = 1 ]; then
		if [ "$forward_mode" = "dnat" -a "$family" = "ipv6" ]; then
			>&2 echo "$(basename "$0"): section $1 option forward_mode 'dnat' not support under IPv6"
			let error++
		fi
		[ "$forward_mode" != "dnat" ] && natloopback=0

		if [ -n "$forward_target" ]; then
			if [ -n "$(hostname_match "$forward_target")" -a -z "$(ip_match ipv4 "$forward_target")" ]; then
				if [ "$forward_mode" = "dnat" ]; then
					>&2 echo "$(basename "$0"): section $1 option forward_target '$forward_target', hostname not support under DNAT mode"
					let error++
				fi
			else
				case "$forward_target" in
					127.*|::1) forward_target="$lan_addr" ;;
					0.*|::)    forward_target="$bind_ip" ;;
				esac

				if [ -n "$forward_target" ]; then
					if [ -z "$(ip_match "$family" "$forward_target")" ]; then
						>&2 echo "$(basename "$0"): section $1 option forward_target '$forward_target' not a $family address"
						let error++
					fi
				else
					>&2 echo "$(basename "$0"): section $1 option forward_target parsing failed, there may be no $family network connection"
					let error++
				fi
			fi
		else
			err_msg__empty "$1" forward_target
			let error++
		fi

		if [ -z "$forward_port" ]; then
			err_msg__empty "$1" forward_port
			let error++
		fi
	elif [ "$forward" = 0 ]; then
		natloopback=0
		unset forward_target forward_port
	fi

	## notify
	if [ "$notify_enable" = 1 ]; then
		[ -x "$notify_script" ] || { >&2 echo "$(basename "$0"): section $1 option notify_script '$notify_script' is empty or non-executable"; let error++; }
	fi

	## ddns
	if [ "$ddns_enable" = 1 ]; then
		[ -x "$ddns_script" ] || { >&2 echo "$(basename "$0"): section $1 option ddns_script '$ddns_script' is empty or non-executable"; let error++; }
		if [ -n "$ddns_srv" ]; then
			if [ -z "$ddns_srv_serv" ]; then
				err_msg__empty "$1" ddns_srv_serv
				let error++
			fi
			local ddns_srv_target=${ddns_srv_target:-$ddns_srv}
		fi
	fi

	# review
	if [ -n "$NATMAP_DEBUG" ]; then
		local v ucivv="enable interval stun_cycle stun_server http_server fwmark_value comment udp_mode proto family bind_ifname ifname bind_ip lan_addr port port_pointer forward forward_mode natloopback forward_congestion forward_timeout forward_target forward_port refresh clt_type clt_scheme clt_web_port clt_username clt_password notify_enable notify_script notify_tokens notify_custom_domain notify_text ddns_enable ddns_script ddns_tokens ddns_a ddns_aaaa ddns_txt ddns_txt_content ddns_srv ddns_srv_serv ddns_srv_proto ddns_srv_target ddns_srv_priority ddns_srv_weight ddns_https ddns_https_target ddns_https_svcparams ddns_https_priority custom_script"
		for v in $ucivv; do eval "echo \"$1 $v='\$$v'\""; done
	fi

	[ "$error" -gt 0 ] && return 1
	natmap_instance "$1"
}

service_triggers() {
	procd_add_reload_trigger natmap 'network'

	local interfaces n
	config_foreach load_interfaces natmap

	if [ -n "$interfaces" ]; then
		for n in $interfaces; do
			procd_add_reload_interface_trigger "$n"
		done
	else
		[ -z "$DEF_WAN$DEF_WAN6" ] && {
			network_find_wan DEF_WAN
			network_find_wan6 DEF_WAN6
		}
		for n in $DEF_WAN $DEF_WAN6; do
			procd_add_reload_interface_trigger "$n"
		done
	fi

	interfaces=$(uci -q show network | grep "device='br-lan'" | cut -f2 -d'.')
	if [ -n "$interfaces" ]; then
		for n in $interfaces; do
			procd_add_reload_interface_trigger "$n"
		done
	fi
	procd_add_validation validate_section_natmap
}

start_service() {
	local sid="$1"
	config_foreach validate_section_global global define_global || return $?
	[ "${GLOBAL_enable:=0}" = "1" ] || return 0

	if ! define_nic 30 2; then
		>&2 echo "$(basename $0): default WAN not detected. service startup will be delayed."
	fi

	if [ -n "$sid" ]; then
		clear_status_files "$sid"
		validate_section_natmap "$sid" launcher
	else
		clear_status_files
		config_foreach validate_section_natmap natmap launcher
	fi
}

stop_service() {
	local sid="$1"
	clear_status_files "$sid"
}

reload_service() {
	stop "$@"
	start "$@"
}

service_started() { procd_set_config_changed firewall; }

service_stopped() { procd_set_config_changed firewall; }
