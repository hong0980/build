# Client listen port refresh script
#
# depends jsonfilter

. /usr/lib/natmap/common.sh

# http_request <cookie> <data>
http_request() {
	$CURL $curl_opts --compressed -L -X POST \
		-b "$1" -H "Content-Type: application/json" \
		-d "$2" \
		--url "${scheme}://${host}:${web_port}/json"
}

start() {
	local curl_opts='-sS --connect-timeout 3 --max-time 10 --retry 0'
	local cookie="$($CURL $curl_opts --compressed -L -i \
		-H "Content-Type: application/json" \
		-d '{"method": "auth.login", "params": ["'"${password}"'"], "id": 1}' \
		--url "${scheme}://${host}:${web_port}/json" \
		| sed -n 's/.*\(_session_id=[^;[:space:]]*\).*/\1/p' | head -n 1)"

	[ -z "$cookie" ] && { echo "Deluge login failed" >&2; return 1; }

	local connected="$(http_request "$cookie" '{"method": "web.connected", "params": [], "id": 1}' | jsonfilter -qe '@.result')"
	if [ "$connected" = "true" ]; then
		http_request "$cookie" '{"method": "core.set_config", "params": [{"random_port": false, "listen_ports": ['"${port}"', '"${port}"']}], "id": 1}' >/dev/null
	else
		echo "Deluge web is not connected to daemon" >&2
	fi

	http_request "$cookie" '{"method": "auth.delete_session", "params": [], "id": 1}' >/dev/null
}


# All external parameters required
ALL_PARAMS="host port scheme web_port username password"
eval "$(JSON_EXPORT "$1")"; shift
start "$@"
