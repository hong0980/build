# depends curl jsonfilter

. /etc/natmap/scripts/common.sh

dg_post() {
	local cookie="$1" data="$2"; shift 2
	http_call --compressed -X POST \
		${cookie:+-b "$cookie"} \
		-H "Content-Type: application/json" \
		-d "$data" \
		--url "${scheme:-http}://${host}:${web_port}/json" \
		"$@"
}

start() {
	local cookie connected
	cookie="$(dg_post "" '{"method":"auth.login","params":["'"${password}"'"],"id":1}' -i \
		| sed -n 's/.*\(_session_id=[^;[:space:]]*\).*/\1/p' | head -n 1)"
	[ -z "$cookie" ] && { echo "Deluge login failed" >&2; return 1; }

	connected="$(dg_post "$cookie" '{"method":"web.connected","params":[],"id":2}' | jsonfilter -qe '@.result')"
	if [ "$connected" = "true" ]; then
		dg_post "$cookie" '{"method":"core.set_config","params":[{"random_port":false,"listen_ports":['"${port}"','"${port}"']}],"id":3}' >/dev/null
		echo "Deluge set port ${port} ok" >&2
	else
		echo "Deluge web is not connected to daemon" >&2
	fi

	dg_post "$cookie" '{"method":"auth.delete_session","params":[],"id":4}' >/dev/null
}

ALL_PARAMS="host port scheme web_port username password"
eval "$(JSON_EXPORT "$1")"; shift
start "$@"
