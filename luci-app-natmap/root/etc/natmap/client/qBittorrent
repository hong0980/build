# depends curl

. /etc/natmap/scripts/common.sh

start() {
	local origin="${scheme:-http}://${host}:${web_port}"
	local base="${origin}/api/v2"
	local cookie="/tmp/qb_natmap_$$.cookie" rc=1

	qb_post() {
		http_call -X POST \
			-H "Origin: ${origin}" \
			-H "Referer: ${origin}" \
			"$@"
	}

	rm -f "$cookie"
	if qb_post -c "$cookie" \
		--data-urlencode "username=${username}" \
		--data-urlencode "password=${password}" \
		"${base}/auth/login" >/dev/null; then
		qb_post -b "$cookie" \
			--data-urlencode "json={\"listen_port\":${port},\"announce_port\":${port}}" \
			"${base}/app/setPreferences" >/dev/null
		rc=$?
		qb_post -b "$cookie" "${base}/auth/logout" >/dev/null
		[ "$rc" -eq 0 ] && echo "qBittorrent set port ${port} ok" >&2 || echo "qBittorrent set port failed" >&2
	else
		echo "qBittorrent login failed" >&2
	fi

	rm -f "$cookie"
	return $rc
}

ALL_PARAMS="host port scheme web_port username password"
eval "$(JSON_EXPORT "$1")"; shift
start "$@"
