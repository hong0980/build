# Client listen port refresh script
#
# depends 

. /etc/natmap/scripts/common.sh

start() {
	[ -n "$port" ] && [ -n "$host" ] && [ -n "$web_port" ] || return 1

	local referer="${scheme:-http}://${host}:${web_port}"
	local base="${referer}/api/v2"
	local cookie="/tmp/qb_natmap_$$.cookie"
	local payload

	case "$(basename "$0")" in
		qBittorrent-announce_port)
			payload="{\"announce_port\":${port}}" ;;
		*)
			payload="{\"listen_port\":${port}}" ;;
	esac

	qb_req() {
		"${CURL:-curl}" -sf --connect-timeout 1 -m 5 -k \
			-H "Origin: ${referer}" \
			-H "Referer: ${referer}" \
			"$@"
	}

	rm -f "$cookie"
	if qb_req -c "$cookie" \
		--data-urlencode "username=${username}" \
		--data-urlencode "password=${password}" \
		"${base}/auth/login" >/dev/null 2>&1; then
		qb_req -b "$cookie" -X POST \
			--data-urlencode "json=${payload}" \
			"${base}/app/setPreferences" >/dev/null 2>&1
		local rc=$?
		qb_req -b "$cookie" -X POST "${base}/auth/logout" >/dev/null 2>&1
		rm -f "$cookie"
		return $rc
	fi

	rm -f "$cookie"
	return 1
}

# All external parameters required
ALL_PARAMS="host port scheme web_port username password"
eval "$(JSON_EXPORT "$1")"; shift
start "$@"
