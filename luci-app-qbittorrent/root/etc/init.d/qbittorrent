#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1
QB_VER=''
. "$IPKG_INSTROOT/usr/share/libubox/jshn.sh"

log_msg() { logger -t "$1" "$2"; }

bool_val() { [ "$1" = "true" ] && echo 1 || echo 0; }

create_directory() {
	for dir in "$@"; do
		[ -n "$dir" ] && [ ! -d "$dir" ] && mkdir -p "$dir" 2>/dev/null
	done
}

get_config() {
	for value in "$@"; do
		config_get "$value" main "$value" ""
	done
}

get_qb_tag() {
	[ -x "$1" ] || return 1
	local tag; tag=$(env HOME=/tmp/qb "$1" -v 2>/dev/null | grep -i 'qbittorrent' | tr ' ' '-')
	[ -n "$tag" ] && echo "$tag"
}

ver_of_tag() {
	echo "$1" | grep -oE 'v[0-9]+(\.[0-9]+)+' | sed 's/^v//'
}

ver_lt() {
	local IFS=. a="$1" b="$2" x y
	while [ -n "$a$b" ]; do
		x=${a%%.*}; y=${b%%.*}
		case "$a" in *.*) a=${a#*.} ;; *) a='' ;; esac
		case "$b" in *.*) b=${b#*.} ;; *) b='' ;; esac
		[ "${x:-0}" -lt "${y:-0}" ] && return 0
		[ "${x:-0}" -gt "${y:-0}" ] && return 1
	done
	return 1
}

qbv() {
	[ -n "$QB_VER" ] || return 1
	case "$1" in
		-lt)    ver_lt "$QB_VER" "$2" ;;
		-gt)    ver_lt "$2" "$QB_VER" ;;
		-ge)    ! ver_lt "$QB_VER" "$2" ;;
		-le)    ! ver_lt "$2" "$QB_VER" ;;
		-range) ! ver_lt "$QB_VER" "$2" && ver_lt "$QB_VER" "$3" ;;
		*)      return 2 ;;
	esac
}

start_service() {
	config_load qbittorrent
	get_config ASWEnabled ASWlist BinaryFiles CSRFProtection DefaultSavePath Enabled Locale PFEnabled Log_Path \
			   RootProfilePath api_key webui_port log_Enabled oldBL olduser oldpass listen_port webuser webpass \
			   PreallocateAll IncompleteFilesExt user group
	[ "$Enabled" = 1 ] || return

	local USER="${user:-root}" GROUP="${group}"
	[ -n "$GROUP" ] || GROUP="$(id -gn "$USER" 2>/dev/null || echo "$USER")"

	create_directory "$Log_Path" "$DefaultSavePath" "$RootProfilePath/qBittorrent/config/"
	QB_CONF="$RootProfilePath/qBittorrent/config/qBittorrent.conf"

	local REAL_PROG="${BinaryFiles:-/usr/bin/qbittorrent-nox}"
	[ -x "$REAL_PROG" ] || chmod 755 "$REAL_PROG" 2>/dev/null

	QB_TAG=$(get_qb_tag "$REAL_PROG")
	if [ -z "$QB_TAG" ]; then
		REAL_PROG="/usr/bin/qbittorrent-nox"
		QB_TAG=$(get_qb_tag "$REAL_PROG")
	fi

	QB_VER=$(ver_of_tag "$QB_TAG")
	local PROG="/var/run/${QB_TAG:-qBittorrent}"
	[ "$REAL_PROG" -ef "$PROG" ] || ln -sf "$REAL_PROG" "$PROG"
	[ "$Locale" = 'zh_CN' ] && qbv -lt 4.5.1 && Locale='zh'

	if [ ! -s "$QB_CONF" ] || [ "$BinaryFiles" != "$oldBL" ]; then
		local Password="@ByteArray(iqdmCO2viX4Z3usDcoVReQ==:yh0o9/aSBv8bxK+ny9i7PF7/zgKh3ASv4Rcogl0GjcDQoxlWQSKUNaKLpNxy/ubnMqPYD2U4sgtGIFXABHNxgQ==)"
		cat <<-EOF > "$QB_CONF"
			[BitTorrent]
			Session\Preallocation="$PreallocateAll"
			Session\AddExtensionToIncompleteFiles="$IncompleteFilesExt"
			[Preferences]
			Downloads\PreAllocation="$PreallocateAll"
			Downloads\UseIncompleteExtension="$IncompleteFilesExt"
			General\Locale="${Locale}"
			WebUI\LocalHostAuth=false
			WebUI\Username="${webuser:-admin}"
			WebUI\Password_PBKDF2="$Password"
			[WebUI]
			LocalHostAuth=false
			Username="${webuser:-admin}"
			Password_PBKDF2="$Password"
		EOF
		uci -q set qbittorrent.main.oldBL="$BinaryFiles"
	fi

	if [ "$USER" != "root" ]; then
		chown "$USER:$GROUP"    "$Log_Path" 2>/dev/null
		chown "$USER:$GROUP"    "$DefaultSavePath" 2>/dev/null
		chown -R "$USER:$GROUP" "$RootProfilePath/qBittorrent" 2>/dev/null
	fi

	procd_open_instance
	procd_set_param command "$PROG" --webui-port="${webui_port:-8080}" --profile="$RootProfilePath"
	if [ -z "$QB_VER" ] || qbv -ge 5.0.0; then
		procd_append_param command --confirm-legal-notice
	fi
	procd_set_param env TZ="$(cat /etc/TZ 2>/dev/null || echo UTC)"
	procd_set_param user  "$USER"
	procd_set_param group "$GROUP"
	procd_set_param pidfile /var/run/qBittorrent.pid
	procd_set_param term_timeout 30
	procd_set_param reload_signal HUP
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_started() {
	[ "$Enabled" = 1 ] || return
	local COOKIE="/tmp/qb_cookie"
	local REFERER="http://127.0.0.1:${webui_port:-8080}"
	local BASE="${REFERER}/api/v2"
	local QB_PID="$QB_TAG[$(cat /var/run/qBittorrent.pid)]"
	local i ready='' SUPPORT_KEY=''
	qbv -ge 5.2.0 && SUPPORT_KEY=1

	for i in $(seq 60); do
		curl -fsS --connect-timeout 2 -m 3 -o /dev/null "$BASE/app/version" >/dev/null 2>&1 && { ready=1; break; }
		sleep 1
	done
	[ -n "$ready" ] || { log_msg "$QB_PID" "❌ 警告: 启动探测超时(60s)，配置同步已推迟"; return 0; }

	json_init
	json_add_int     "listen_port" "${listen_port:-8999}"
	json_add_string  "locale" "${Locale:-zh_CN}"
	json_add_string  "save_path" "$DefaultSavePath"
	json_add_string  "bypass_auth_subnet_whitelist" "$ASWlist"
	json_add_string  "file_log_path" "${Log_Path:-"$RootProfilePath/qBittorrent/data/logs"}"
	json_add_string  "web_ui_username" "$webuser"
	[ "$webpass" != "${oldpass:-password}" ] && json_add_string  "web_ui_password" "$webpass"
	json_add_boolean "upnp" "$(bool_val "$PFEnabled")"
	json_add_boolean "file_log_enabled" "$(bool_val "$log_Enabled")"
	json_add_boolean "preallocate_all" "$(bool_val "$PreallocateAll")"
	json_add_boolean "incomplete_files_ext" "$(bool_val "$IncompleteFilesExt")"
	json_add_boolean "web_ui_csrf_protection_enabled" "$(bool_val "$CSRFProtection")"
	json_add_boolean "bypass_auth_subnet_whitelist_enabled" "$(bool_val "$ASWEnabled")"
	local dump_data=$(json_dump)

	qb_req() { curl -sf -m 5 -H "Origin: $REFERER" -H "Referer: $REFERER" "$@"; }
	{ [ -n "$api_key" ] && \
		qb_req -X POST \
			-H "Authorization: Bearer $api_key" \
			--data-urlencode "json=$dump_data" \
			"$BASE/app/setPreferences" >/dev/null 2>&1; } || \
	{ [ -f "$COOKIE" ] && \
		grep -qi "SID" "$COOKIE" 2>/dev/null && \
		qb_req -b "$COOKIE" \
			--data-urlencode "json=$dump_data" \
			"$BASE/app/setPreferences" >/dev/null 2>&1; } || \
	{   rm -f "$COOKIE"
		qb_req -c "$COOKIE" \
			--data-urlencode "username=${olduser:-$webuser}&password=${oldpass:-password}" \
			"$BASE/auth/login" >/dev/null 2>&1 || \
		qb_req -c "$COOKIE" \
			--data-urlencode "username=$webuser&password=$webpass" \
			"$BASE/auth/login" >/dev/null 2>&1

		grep -qi "SID" "$COOKIE" 2>/dev/null && \
			qb_req -b "$COOKIE" \
			--data-urlencode "json=$dump_data" \
			"$BASE/app/setPreferences" >/dev/null 2>&1
	} || log_msg "$QB_PID" "❌ 警告: 认证未通过！请同步 WebUI 的用户名和密码配置。"

	if [ -z "$api_key" ] && [ -n "$SUPPORT_KEY" ] && grep -qi "SID" "$COOKIE" 2>/dev/null; then
		local APIKey=$(qb_req -b "$COOKIE" -X POST "$BASE/app/rotateAPIKey" | jsonfilter -qe '@.apiKey')
		uci -q set qbittorrent.main.api_key="$APIKey"
	fi
	if [ "$webuser" != "$olduser" ] || [ "$webpass" != "$oldpass" ]; then
		uci -q set qbittorrent.main.olduser="$webuser"
		uci -q set qbittorrent.main.oldpass="$webpass"
	fi
	[ -n "$SUPPORT_KEY" ] || uci -q delete qbittorrent.main.api_key
	uci -q commit qbittorrent
}

service_triggers() {
	procd_add_reload_trigger qbittorrent
}
