#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1
. "$IPKG_INSTROOT/usr/share/libubox/jshn.sh"

log_msg() { logger -t "qBittorrent" "$1"; }

bool_val() { [ "$1" = "true" ] && echo 1 || echo 0; }

create_directory() {
	for dir in "$@"; do
		[ -n "$dir" -a ! -d "$dir" ] && mkdir -p "$dir" 2>/dev/null
	done
}

get_config() {
	for value in "$@"; do
		config_get "$value" main "$value" ""
	done
}

get_qb_tag() {
	local prog_path="$1"
	[ -x "$prog_path" ] || return 1

	local tag; tag=$("$prog_path" --version 2>/dev/null | grep -ioE 'qbittorrent v[0-9]+(\.[0-9]+)+' | tr ' ' '-')
	[ -n "$tag" ] || return 1
	echo "$tag"
	return 0
}

start_service() {
	config_load qbittorrent
	get_config Locale EnableService RootProfilePath logEnabled port \
			   DefaultSavePath ASWEnabled ASWlist webuser BinaryFiles \
			   CSRFProtection PasswordEnabled Path PFEnabled oldBL
	[ "$EnableService" = 1 ] || return

	create_directory "$Path" "$DefaultSavePath" "$RootProfilePath/qBittorrent/config/"
	local qb_conf="$RootProfilePath/qBittorrent/config/qBittorrent.conf"

	if [ ! -s "$qb_conf" ] || [ "$BinaryFiles" != "$oldBL" ]; then
		local Password="@ByteArray(lp3H/oqnSYXj73Llw1iZXA==:lUIJYPbvLDlgOu9EJXjWtuuYVoaLKmjUMZKeYG/hK9mqXEix02t6tQD5VUf8fYJlHSiEOB1r8Zbw9H17JMUFqw==)"
		cat <<-EOF > "$qb_conf"
		[Application]
		FileLogger\Enabled="$Enabled"
		FileLogger\Path="$RootProfilePath/qBittorrent/data/logs"
		[BitTorrent]
		Session\AddExtensionToIncompleteFiles=true
		Session\ExcludedFileNames=
		Session\Preallocation=true
		Session\DefaultSavePath="$DefaultSavePath"
		[Network]
		PortForwardingEnabled="$PFEnabled"
		[Preferences]
		General\Locale="$Locale"
		WebUI\LocalHostAuth=false
		WebUI\CSRFProtection="$CSRFProtection"
		WebUI\AuthSubnetWhitelistEnabled="$ASWEnabled"
		WebUI\AuthSubnetWhitelist="${ASWlist}"
		WebUI\Username="${webuser:-admin}"
		WebUI\Password_PBKDF2="$Password"
		[WebUI]
		LocalHostAuth=false
		CSRFProtection="$CSRFProtection"
		AuthSubnetWhitelistEnabled="$ASWEnabled"
		AuthSubnetWhitelist="${ASWlist}"
		Username="${webuser:-admin}"
		Password_PBKDF2="$Password"
		EOF
		uci -q set qbittorrent.main.oldBL="$BinaryFiles"
		uci -q set qbittorrent.main.olduser="$webuser"
		uci -q set qbittorrent.main.oldpass="qbittorrent_nox"
		uci -q commit qbittorrent
	fi

	local REAL_PROG="${BinaryFiles:-/usr/bin/qbittorrent-nox}"
	[ -x "$REAL_PROG" ] || chmod 755 "$REAL_PROG" 2>/dev/null

	local QB_TAG; QB_TAG=$(get_qb_tag "$REAL_PROG")
	if [ -z "$QB_TAG" ]; then
		REAL_PROG="/usr/bin/qbittorrent-nox"
		QB_TAG=$(get_qb_tag "$REAL_PROG")
	fi

	local PROG="/var/run/${QB_TAG:-qBittorrent-unknown}"
	ln -sf "$REAL_PROG" "$PROG"

	procd_open_instance
	procd_set_param command "$PROG" --webui-port="$port" --profile="$RootProfilePath" --confirm-legal-notice
	procd_set_param env TZ="$(cat /etc/TZ 2>/dev/null || echo UTC)"
	procd_set_param user "root"
	procd_set_param pidfile /var/run/qbittorrent_nox.pid
	procd_set_param term_timeout 30
	procd_set_param reload_signal HUP
	procd_set_param respawn 3600 5 0
	procd_set_param limits core="unlimited"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_started() {
	config_load qbittorrent
	get_config port EnableService webuser webpass olduser oldpass \
			   DefaultSavePath PFEnabled logEnabled RootProfilePath \
			   CSRFProtection ASWEnabled ASWlist Path Locale
	[ "$EnableService" = 1 ] || return

	local COOKIE=$(mktemp 2>/dev/null || echo "/tmp/qb_cookie_$$")
	local REFERER="http://127.0.0.1:${port}"
	local BASE="${REFERER}/api/v2"

	local ready=0
	for i in $(seq 1 60); do
		if curl -fsS --connect-timeout 2 -m 3 "${BASE}/app/version" >/dev/null 2>&1; then
			ready=1
			break
		fi
		sleep 1
	done

	if [ "$ready" -ne 1 ]; then
		log_msg "警告: qBittorrent 启动探测超时 (60s)，API 配置同步已推迟"
		rm -f "$COOKIE" 2>/dev/null
		return 0
	fi

	local HTTP_CODE=$(curl -s -o /dev/null -w "%{http_code}" \
		-c "$COOKIE" \
		-H "Origin: ${REFERER}" \
		-H "Host: 127.0.0.1:${port}" \
		-H "Referer: ${REFERER}/" \
		--data-urlencode "username=${olduser:-$webuser}" \
		--data-urlencode "password=${oldpass:-"qbittorrent_nox"}" \
		"${BASE}/auth/login" 2>/dev/null)

	if ! { [ "$HTTP_CODE" = "200" ] || [ "$HTTP_CODE" = "204" ]; } && ! grep -qi "SID" "$COOKIE" 2>/dev/null; then
		log_msg "提示: WebUI API 认证未通过（可能是用户在界面单独设置了新密码或开启了严格局域网白名单），跳过 API 覆盖"
		rm -f "$COOKIE" 2>/dev/null
		return 0
	fi

	json_init
	json_add_string  "locale" "$Locale"
	json_add_string  "web_ui_username" "$webuser"
	json_add_string  "web_ui_password" "$webpass"
	json_add_string  "save_path" "$DefaultSavePath"
	json_add_string  "file_log_path" "${Path:-"$RootProfilePath/qBittorrent/data/logs"}"
	json_add_boolean "upnp" "$(bool_val "$PFEnabled")"
	json_add_boolean "file_log_enabled" "$(bool_val "$logEnabled")"
	json_add_boolean "web_ui_csrf_protection_enabled" "$(bool_val "$CSRFProtection")"
	json_add_boolean "bypass_auth_subnet_whitelist_enabled" "$(bool_val "$ASWEnabled")"
	[ -n "$ASWlist" ] && json_add_string  "bypass_auth_subnet_whitelist" "$ASWlist"

	local dump_data=$(json_dump)
	curl -s -b "$COOKIE" \
		-H "Origin: ${REFERER}" \
		-H "Host: 127.0.0.1:${port}" \
		-H "Referer: ${REFERER}/" \
		--data-urlencode "json=${dump_data}" \
		"${BASE}/app/setPreferences" >/dev/null 2>&1

	if [ "${webuser}" != "$olduser" ] || [ "${webpass}" != "$oldpass" ]; then
		uci -q set qbittorrent.main.olduser="$webuser"
		uci -q set qbittorrent.main.oldpass="$webpass"
		uci -q commit qbittorrent
	fi
}

service_triggers() {
	procd_add_reload_trigger qbittorrent
}
